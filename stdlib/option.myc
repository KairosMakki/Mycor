// Option helpers.

enum Option[T] {
    Some(T),
    None,
}

fn some[T](v: T) -> Option[T] {
    Some(v)
}

fn none[T]() -> Option[T] {
    Option::None
}

fn is_some[T](o: Option[T]) -> bool {
    match o {
        Some(_) => true,
        None => false,
    }
}

fn unwrap_or[T](o: Option[T], d: T) -> T {
    match o {
        Some(v) => v,
        None => d,
    }
}