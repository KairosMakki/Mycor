// Iteration helpers.

fn sum_range(start: i32, end: i32) -> i32 {
    let mut acc = 0;
    let mut i = start;
    while i < end {
        acc = acc + i;
        i = i + 1;
    }
    acc
}

fn count_range(start: i32, end: i32) -> i32 {
    end - start
}

fn factorial(n: i32) -> i32 {
    let mut acc = 1;
    let mut i = 2;
    while i <= n {
        acc = acc * i;
        i = i + 1;
    }
    acc
}